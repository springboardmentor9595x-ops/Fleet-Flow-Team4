# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fleetflow

# Security Settings
SECRET_KEY=change_this_to_a_secure_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application URL
APP_BASE_URL=http://localhost:3000

# Admin / System Email Address
ADMIN_EMAIL=admin@example.com

# SMTP Email Configuration (Optional - for sending notification & verification emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=True
SMTP_USE_SSL=False
